PORT=3000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/lumisec

# PostgreSQL (GRC module)
PG_HOST=localhost
PG_PORT=5432
PG_USER=lumisec
PG_PASSWORD=secret
PG_DATABASE=lumisec_grc

# Redis
REDIS_URL=redis://localhost:6379

# GRC file storage
UPLOAD_DIR=uploads/evidence
REPORT_DIR=uploads/reports

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# ELK Stack
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme

# OpenCTI
OPENCTI_URL=http://localhost:8080
OPENCTI_TOKEN=your_opencti_token

# Firewall (Fortigate)
FORTIGATE_HOST=192.168.1.1
FORTIGATE_TOKEN=your_fortigate_api_token
# pfSense SSH fallback
PFSENSE_HOST=192.168.1.1
PFSENSE_USER=admin
PFSENSE_PASSWORD=your_pfsense_password

# Mail Server
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your_smtp_password
SMTP_FROM=LumiSec <noreply@yourdomain.com>

# Linux VM
LINUX_VM_HOST=192.168.10.10
LINUX_VM_USER=root
LINUX_VM_KEY_PATH=./config/linux_vm_key.pem

# Windows 7 VM
WINDOWS_VM_HOST=192.168.10.20
WINDOWS_VM_USER=Administrator
WINDOWS_VM_PASSWORD=your_windows_password
WINRM_PORT=5985
