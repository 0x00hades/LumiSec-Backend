            }
          }
        },
        {
          "name": "Track Event Public",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "User-Agent", "value": "Postman Runtime" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"click\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/phishing/track/{{trackingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "phishing", "track", "{{trackingId}}"]
            }
          }
        }
      ]
    },
