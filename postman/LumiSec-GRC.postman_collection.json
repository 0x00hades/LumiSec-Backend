          "name": "Mark Notification Read",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/grc/notifications/{{notificationId}}/read"
          }
        }
      ]
    },
    {
      "name": "Integrations",
      "description": "Cross-module ingestion endpoints. Called by Network, UCTC, SOAR, Phishing, SIEM, and OpenCTI modules.",
      "item": [
        {
          "name": "Network → Finding",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Rogue device detected on VLAN 10\",\n  \"description\": \"Unauthorized MAC address 00:1A:2B:3C:4D:5E detected\",\n  \"severity\": \"high\",\n  \"asset\": \"00:1A:2B:3C:4D:5E\",\n  \"findingType\": \"rogue_device\",\n  \"sourceId\": \"net-scan-2026-042\",\n  \"tags\": [\"network\", \"rogue_device\"]\n}"
            },
            "url": "{{baseUrl}}/api/grc/integrations/network/findings"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json?.data?._id) pm.collectionVariables.set('findingId', json.data._id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
