{
  "info": {
    "_postman_id": "a3b8c4d1-9e2f-4a1b-8c7d-6f5e4d3c2b1a",
    "name": "LumiSec GRC API",
    "description": "Complete Postman collection for the LumiSec GRC (Governance, Risk & Compliance) module.\n\n**Setup:**\n1. Set `{{baseUrl}}` (default: http://localhost:3000)\n2. Run **Auth → Login** (or Signup) to populate `{{token}}`\n3. Run **Findings → Create Finding** to populate `{{findingId}}`\n4. Use folder requests in workflow order for best results\n\n**Roles:** admin, grc_manager, auditor, soc_manager, soc_analyst, detection_engineer, compliance_manager, it_manager, assignee\n\n**Docs:** helpo/LumiSec-GRC-API-Documentation.md",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('baseUrl')) {",
          "  pm.collectionVariables.set('baseUrl', 'http://localhost:3000');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Authenticate before calling GRC endpoints. Token is saved to collection variables.",
      "item": [
        {
          "name": "Signup (GRC Admin)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"GRC Admin\",\n  \"email\": \"grc-admin@lumisec.io\",\n  \"password\": \"Password123\",\n  \"role\": \"grc_manager\",\n  \"department\": \"GRC\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/signup",
            "description": "Create a grc_manager user for testing GRC endpoints."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json?.data?.token) pm.collectionVariables.set('token', json.data.token);",
                  "if (json?.data?.user?._id) {",
                  "  pm.collectionVariables.set('userId', json.data.user._id);",
                  "  pm.collectionVariables.set('assigneeId', json.data.user._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"grc-admin@lumisec.io\",\n  \"password\": \"Password123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json?.data?.token) pm.collectionVariables.set('token', json.data.token);",
                  "if (json?.data?.user?._id) {",
                  "  pm.collectionVariables.set('userId', json.data.user._id);",
                  "  pm.collectionVariables.set('assigneeId', json.data.user._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/profile"
          }
        }
      ]
    },
    {
      "name": "Findings",
      "item": [
        {
          "name": "Create Finding",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Missing MFA on admin accounts\",\n  \"description\": \"Privileged accounts lack multi-factor authentication\",\n  \"severity\": \"high\",\n  \"riskRating\": \"high\",\n  \"asset\": \"auth-server-01\",\n  \"tags\": [\"identity\", \"mfa\"],\n  \"dueDate\": \"2026-07-01T00:00:00.000Z\"\n}"
            },
            "url": "{{baseUrl}}/api/grc/findings"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json?.data?._id) pm.collectionVariables.set('findingId', json.data._id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "List Findings",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/grc/findings?page=1&limit=20&severity=high&status=open&search=mfa",
              "host": ["{{baseUrl}}"],
              "path": ["api", "grc", "findings"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "severity", "value": "high", "disabled": true },
                { "key": "status", "value": "open", "disabled": true },
                { "key": "sourceModule", "value": "manual", "disabled": true },
                { "key": "riskRating", "value": "high", "disabled": true },
                { "key": "asset", "value": "", "disabled": true },
                { "key": "search", "value": "mfa", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Finding by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/grc/findings/{{findingId}}"
          }
        },
        {
          "name": "Update Finding",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Missing MFA on admin accounts — escalated\",\n  \"severity\": \"critical\",\n  \"riskRating\": \"critical\",\n  \"tags\": [\"identity\", \"mfa\", \"escalated\"]\n}"
            },
            "url": "{{baseUrl}}/api/grc/findings/{{findingId}}"
          }
        },
        {
          "name": "Assign Finding",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assignedTo\": \"{{assigneeId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/grc/findings/{{findingId}}/assign"
          }
        },
        {
          "name": "Close Finding",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/grc/findings/{{findingId}}/close"
          }
        },
        {
          "name": "Reopen Finding",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/grc/findings/{{findingId}}/reopen"
          }
        },
        {
          "name": "Delete Finding",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/grc/findings/{{findingId}}"
          }
        },
        {
          "name": "Get Finding History",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/grc/findings/{{findingId}}/history"
          }
        }
      ]
    },
