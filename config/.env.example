PORT=3000
NODE_ENV=development

# CORS / Frontend (add every origin that serves the React app)
FRONTEND_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

# MongoDB
MONGO_URI=mongodb://localhost:27017/lumisec
MONGO_TRANSACTIONS=false

# PostgreSQL (GRC module)
PG_HOST=localhost
PG_PORT=5432
PG_USER=lumisec
PG_PASSWORD=secret
PG_DATABASE=lumisec_grc

# Redis (required for phishing email + tracking workers)
REDIS_URL=redis://localhost:6379

# GRC file storage
UPLOAD_DIR=uploads/evidence
REPORT_DIR=uploads/reports

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Service-to-service integration auth
INTERNAL_API_KEY=change_me_internal_api_key
INTERNAL_API_BASE_URL=http://localhost:3000
INTEGRATION_TIMEOUT_MS=15000
INTEGRATION_RETRY_COUNT=2
INTEGRATION_MODE=inprocess
QUEUE_PREFIX=lumisec

# UCTC sandbox
UCTC_SANDBOX_MODE=mock
UCTC_SANDBOX_TIMEOUT_SEC=30
UCTC_SANDBOX_MEMORY=512m
UCTC_SANDBOX_CPUS=1
UCTC_SANDBOX_PIDS_LIMIT=128
UCTC_SANDBOX_USER=1000:1000
UCTC_MAX_OUTPUT_BYTES=50000
UCTC_SANDBOX_POWERSHELL_IMAGE=mcr.microsoft.com/powershell:latest
UCTC_SANDBOX_PYTHON_IMAGE=python:3.12-alpine
UCTC_SANDBOX_BASH_IMAGE=bash:5.2
SIEM_DEPLOYMENT_MODE=mock

# LumiNet network tool
LUMINET_SCAN_MODE=local
LUMINET_SNIFFING_MODE=worker
LUMINET_SCAN_TIMEOUT_SEC=60
LUMINET_SCAN_CONCURRENCY=64
LUMINET_MAX_DISCOVERY_HOSTS=256
LUMINET_PING_TIMEOUT_MS=1000
LUMINET_CONNECT_TIMEOUT_MS=1200
LUMINET_BANNER_TIMEOUT_MS=2000
LUMINET_MAX_PACKET_SAMPLES=100
LUMINET_SCANNER_WORKER_URL=http://localhost:4100
LUMINET_SNIFFER_WORKER_URL=http://localhost:4200

# SOAR Connector Engine (optional external Python backend)
CONNECTOR_ENGINE_URL=http://localhost:4101
CONNECTOR_ENGINE_API_KEY=
CONNECTOR_ENGINE_TIMEOUT_MS=15000
CONNECTOR_ENGINE_RETRY_COUNT=2
CONNECTOR_DISCOVERY_CACHE_MS=300000
SOAR_CONNECTOR_MODE=local

# ELK Stack
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme

# OpenCTI
OPENCTI_URL=http://localhost:8080
OPENCTI_TOKEN=your_opencti_token

# Firewall (Fortigate) — optional
FORTIGATE_HOST=192.168.1.1
FORTIGATE_TOKEN=your_fortigate_api_token

# pfSense SSH fallback — optional
PFSENSE_HOST=192.168.1.1
PFSENSE_USER=admin
PFSENSE_PASSWORD=your_pfsense_password

# ─── Phishing simulation ───────────────────────────────────────────────────────
# Public API URL — REQUIRED in production for open-rate tracking (auto-appends /api/phishing)
API_PUBLIC_URL=https://api.yourdomain.com
# Or set the full tracking base explicitly:
# PHISHING_TRACKING_DOMAIN=https://api.yourdomain.com/api/phishing
# Local dev only — expose localhost via ngrok so Gmail can reach the open pixel:
# NGROK_URL=https://your-subdomain.ngrok-free.app

# SMTP (Titan Email example — replace with your credentials)
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_USER=support@yourdomain.com
SMTP_PASS=your_smtp_password
SMTP_FROM=LumiSec Support <support@yourdomain.com>
# SMTP_TLS_REJECT_UNAUTHORIZED=false

# Workers (run alongside the API for phishing campaigns):
#   npm run worker:email
#   npm run worker:tracking

# Linux VM — optional
LINUX_VM_HOST=192.168.10.10
LINUX_VM_USER=root
LINUX_VM_KEY_PATH=./config/linux_vm_key.pem

# Windows VM — optional
WINDOWS_VM_HOST=192.168.10.20
WINDOWS_VM_USER=Administrator
WINDOWS_VM_PASSWORD=your_windows_password
WINRM_PORT=5985
